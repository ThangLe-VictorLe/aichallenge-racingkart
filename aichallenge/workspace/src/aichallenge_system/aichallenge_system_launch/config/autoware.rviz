Panels:
  - Class: rviz_editor_plugins/CsvMarkerDisplay
    Name: CsvMarkerDisplay
  - Class: rviz_editor_plugins/EditorTool
    Name: EditorTool
  - Class: aichallenge_rviz_plugin::GraphPanel
    Name: GraphPanel
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Third Person Follower1/Focal Point1
    Name: Views
    Splitter Ratio: 0.5
  - Class: aichallenge_control_rviz_plugin/ControlModePanel
    Name: ControlModePanel
  - Class: rviz_common/Displays
    Help Height: 144
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Control1/MPC prediction1
        - /ref_path1/Topic1
        - /ref_path1/Namespaces1
        - /Dynamic obstacles1
        - /Path corridor1
        - /v2x status1
      Splitter Ratio: 0.5
    Tree Height: 287
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/TF
