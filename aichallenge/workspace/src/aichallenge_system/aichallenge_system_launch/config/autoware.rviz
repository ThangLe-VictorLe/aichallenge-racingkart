            camera_link:
              Alpha: 1
              Show Axes: false
              Show Trail: false
              Value: true
            camera_optical_link:
              Alpha: 1
              Show Axes: false
              Show Trail: false
            gnss_link:
              Alpha: 1
              Show Axes: false
              Show Trail: false
