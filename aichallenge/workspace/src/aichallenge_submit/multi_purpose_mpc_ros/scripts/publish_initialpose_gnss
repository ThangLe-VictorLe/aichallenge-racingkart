#!/usr/bin/env python3

import time
import math

# ROS 2
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PoseWithCovarianceStamped
from nav_msgs.msg import Odometry
from std_srvs.srv import Trigger

class PublishInitialPoseGnss(Node):
    def __init__(self):
        super().__init__("publish_initialpose_gnss")

        self._gnss_pose = None
        self._kinematic_pose = None
        self._last_publish_time = 0.0
        self._distance_threshold = 5.0  # meters
        self._cooldown_sec = 2.0        # seconds to wait after a teleport before checking again

        self.sub_gnss = self.create_subscription(PoseWithCovarianceStamped, '/sensing/gnss/pose_with_covariance', self.on_gnss_cov_pose, 1)
        self.sub_odom = self.create_subscription(Odometry, '/localization/kinematic_state', self.on_kinematic_state, 1)
        
        # Service client to trigger RViz plugin's Initial Pose Set (which uses trajectory heading!)
        self.srv_client = self.create_client(Trigger, '/set_initial_pose')

        # Check distance at 10Hz
        self.timer = self.create_timer(0.1, self.check_and_publish)
        
        self.get_logger().info("Auto GNSS Initializer Node started. Threshold: 5.0m. Using RViz set_initial_pose service.")

    def on_gnss_cov_pose(self, msg: PoseWithCovarianceStamped):
        self._gnss_pose = msg

    def on_kinematic_state(self, msg: Odometry):
        self._kinematic_pose = msg

    def check_and_publish(self):
        if self._gnss_pose is None:
            return
            
        current_time = time.time()
        if current_time - self._last_publish_time < self._cooldown_sec:
            return

        distance = 999.0
        
        if self._kinematic_pose is None:
            # If we don't have a kinematic state yet, we should probably publish immediately to initialize it
            distance = 999.0
        else:
            gx = self._gnss_pose.pose.pose.position.x
            gy = self._gnss_pose.pose.pose.position.y
            kx = self._kinematic_pose.pose.pose.position.x
            ky = self._kinematic_pose.pose.pose.position.y
            distance = math.hypot(gx - kx, gy - ky)

        if distance > self._distance_threshold:
            self.get_logger().info(f"Distance between GNSS and EKF is {distance:.2f}m (Threshold: {self._distance_threshold}m). Requesting Initial Pose via service...")
            self.call_initial_pose_service()
            self._last_publish_time = time.time()

    def call_initial_pose_service(self):
        if not self.srv_client.wait_for_service(timeout_sec=1.0):
            self.get_logger().warn("Service /set_initial_pose not available!")
            return
            
        req = Trigger.Request()
        future = self.srv_client.call_async(req)
        # We don't necessarily need to block and wait for the result here since it's just a trigger
        future.add_done_callback(self.service_callback)
        
    def service_callback(self, future):
        try:
            response = future.result()
            self.get_logger().info(f"Initial Pose Service Response: success={response.success}, message='{response.message}'")
        except Exception as e:
            self.get_logger().error(f"Service call failed: {e}")

def main(args=None):
    rclpy.init(args=args)

    try:
        node = PublishInitialPoseGnss()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        rclpy.shutdown()


if __name__ == "__main__":
    main()
