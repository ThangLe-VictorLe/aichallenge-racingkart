{
  "project_name": "AI Challenge Racing Kart",
  "description": "A ROS2 and AWSIM based racing kart simulation and evaluation environment.",
  "target_workspace": "/home/victor/aichallenge-racingkart/aichallenge/workspace/src/aichallenge_submit",
  "submission_rules": {
    "tar_format": "The tar.gz must have 'aichallenge_submit/' as the root directory.",
    "entry_launch_file": "aichallenge_submit_launch/aichallenge_submit.launch.xml",
    "control_methods": [
      "mpc",
      "pure_pursuit",
      "tiny_lidar_net",
      "pilot_net",
      "joycon"
    ],
    "default_control_method": "mpc"
  },
  "interfaces": {
    "inputs_from_awsim": {
      "/sensing/imu/imu_raw": "sensor_msgs/Imu",
      "/sensing/gnss/nav_sat_fix": "sensor_msgs/NavSatFix",
      "/vehicle/status/velocity_status": "autoware_auto_vehicle_msgs/VelocityReport",
      "/clock": "rosgraph_msgs/Clock"
    },
    "outputs_to_awsim": {
      "/control/command/control_cmd": "autoware_auto_control_msgs/AckermannControlCommand"
    },
    "required_internal_topics": {
      "/localization/kinematic_state": "nav_msgs/Odometry",
      "/planning/scenario_planning/trajectory": "autoware_auto_planning_msgs/Trajectory"
    },
    "required_services": {
      "/set_initial_pose": "std_srvs/srv/Trigger"
    }
  },
  "packages_in_aichallenge_submit": [
    "aichallenge_submit_launch",
    "gyro_odometer",
    "imu_corrector",
    "imu_gnss_poser",
    "laserscan_generator",
    "multi_purpose_mpc_ros",
    "multi_purpose_mpc_ros_msgs",
    "path_to_trajectory",
    "pilot_net_controller",
    "racing_kart_description",
    "racing_kart_gnss_poser",
    "racing_kart_sensor_kit_description",
    "simple_pure_pursuit",
    "simple_trajectory_generator",
    "tiny_lidar_net_controller"
  ],
  "development_commands": {
    "build_image": "./docker_build.sh dev",
    "build_workspace": "make autoware-build",
    "run_dev": "make dev",
    "stop": "make down",
    "run_eval": "./docker_build.sh eval --submit <tar> && make eval"
  },
  "domain_rules": {
    "domain_0": "AWSIM Simulator and awsim_state_manager_node",
    "domain_N": "Participant Autoware instance (Domain 1..N). Do not use Domain 0 for vehicles.",
    "cross_domain_communication": "Only via aichallenge_system/v2x_msgs on /v2x/vehicle_positions."
  }
}
